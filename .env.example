# ============================================
# DreamReel / 梦卷 - 环境配置
# ============================================

# 运行环境
NODE_ENV=development
PORT=3000

# ============================================
# 视频生成 Provider
# 可选: mock | runway | pika | seedance | minimax | wan
# ============================================
VIDEO_PROVIDER=mock

# Runway API (https://runwayml.com/)
RUNWAY_API_KEY=
# RUNWAY_MODEL=gen3a_turbo

# Pika API (https://pika.art/)
PIKA_API_KEY=
# PIKA_MODEL=pika-1.0

# Seedance / 字节跳动方舟 (https://www.volcengine.com/docs/82379)
SEEDANCE_API_KEY=
# SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDANCE_MODEL=seedance-2.5

# Minimax / 海螺 AI (https://platform.minimaxi.com/)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=video-01

# Wan / 通义万相 (https://help.aliyun.com/zh/dashscope/)
WAN_API_KEY=
# WAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# WAN_MODEL=wanx2.1-t2v-plus

# 视频生成并发数
VIDEO_MAX_CONCURRENT=3
# 视频任务轮询窗口（毫秒）与间隔（毫秒），默认 30 分钟窗口
# VIDEO_POLL_MAX_MS=1800000
# VIDEO_POLL_INTERVAL_MS=1000

# ============================================
# ComfyUI（自托管，另一台机器，内网直连）
# 作为视频 Provider：VIDEO_PROVIDER=comfyui
# ============================================
COMFYUI_BASE_URL=http://192.168.31.113:8188
# 主机白名单（逗号分隔；为空则自动取 COMFYUI_BASE_URL 的主机名）
COMFYUI_ALLOWED_HOSTS=
# 反向代理鉴权时填（ComfyUI 本体默认不校验）
COMFYUI_API_TOKEN=
COMFYUI_MAX_CONCURRENT=1
COMFYUI_POLL_INTERVAL_MS=3000
COMFYUI_MAX_POLL_MS=1800000
COMFYUI_SUBMIT_TIMEOUT_MS=30000
COMFYUI_DOWNLOAD_MAX_BYTES=268435456
# 工作流模板（为空则用内置 wan22_ti2v.json）
COMFYUI_WORKFLOW=
COMFYUI_WIDTH=832
COMFYUI_HEIGHT=480
COMFYUI_LENGTH=49
COMFYUI_STEPS=20
COMFYUI_FPS=16

# ============================================
# LLM Provider (剧本助手 / AI 影评)
# 可选: mock | openai
# 支持任何 OpenAI 兼容 API（vLLM、Ollama、Azure 等）
# ============================================
LLM_PROVIDER=mock
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# 自定义 API 端点（用于兼容其他 OpenAI 兼容服务）
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenCode（LLM_PROVIDER=opencode）：经本机 OpenCode 2.x 服务路由
# 需 `npm run llm:serve` 启动（依赖 @opencode/cli 2.x；系统 opencode 1.x 不兼容 SDK 5）
OPENCODE_API_KEY=
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=
# OPENCODE_MODEL=opencode/big-pickle
# OPENCODE_SERVE_PORT=4096

# LiteLLM 网关（LLM_PROVIDER=litellm）：见 litellm/README.md
# LITELLM_MASTER_KEY=sk-dreamreel-local-litellm
# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# LITELLM_MODEL=deepseek-flash

# 执行级回退（逗号分隔 provider id；主失败时按序切换）
# LLM_FALLBACK_PROVIDERS=deepseek
# IMAGE_FALLBACK_PROVIDERS=mock
# TTS_FALLBACK_PROVIDERS=elevenlabs
# 视频回退仅作用于**提交阶段**（提交成功后固定 provider 轮询）
# VIDEO_FALLBACK_PROVIDERS=seedance
# LLM_ATTEMPT_TIMEOUT_MS=30000   # 单次尝试软超时（毫秒，0=关）

# ============================================
# TTS Provider (配音字幕)
# 可选: mock | elevenlabs
# ============================================
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4Tlv
# ELEVENLABS_MODEL=eleven_monolingual_v1

# ============================================
# Image Provider (R32 图片生成)
# 可选: mock | openai
# openai 兼容任何 OpenAI Images API 服务，可用 OPENAI_IMAGE_BASE_URL 指向自建网关
# ============================================
IMAGE_PROVIDER=mock
OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-1

# ============================================
# 角色一致性
# ============================================
CHARACTER_CONSISTENCY_THRESHOLD=0.65

# ============================================
# 存储
# ============================================
STORAGE_PATH=./storage

# ============================================
# 网盘同步（WebDAV / NAS）
# 兼容群晖 Synology / Nextcloud / 坚果云 / 阿里云盘 WebDAV 等标准 WebDAV
# 例：群晖 https://your-nas:5006/dav   （套件「WebDAV Server」）
#     Nextcloud https://cloud.example.com/remote.php/dav/files/<user>
#    坚果云 https://dav.jianguoyun.com/dav
# 留空则关闭 WebDAV 同步；也可在同步请求体里临时传 url/username/password
# ============================================
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
# WEBDAV_TOKEN=            # 若用 Bearer token 鉴权（优先于用户名密码）
# WEBDAV_ROOT=DreamReel    # 远端根目录
# WEBDAV_TIMEOUT_MS=60000
# WEBDAV_CONCURRENCY=3
# WEBDAV_RETRIES=2

# ============================================
# 夸克网盘同步（私有接口，需 cookie）
# cookie 从浏览器 pan.quark.cn 请求头复制（含 __puus 等）；请勿提交到版本库
# 未配置时：dry-run 可用，真实上传会如实报错
# ============================================
# QUARK_COOKIE=
# QUARK_ROOT=DreamReel
# QUARK_API_BASE=https://drive-pc.quark.cn/1/clouddrive
# QUARK_OSS_HOST=oss-cn-shenzhen.aliyuncs.com
# QUARK_PART_SIZE=4194304
# QUARK_CONCURRENCY=1
# QUARK_TIMEOUT_MS=60000
# QUARK_RETRIES=2

# ============================================
# 认证
# ============================================
JWT_SECRET=dreamreel-dev-secret-change-in-production
# JWT_EXPIRES_IN=7d

# ============================================
# 支付（Stripe，可选）
# ============================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
