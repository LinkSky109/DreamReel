# ============================================
# DreamReel / 梦卷 - 环境配置
# ============================================

# 运行环境
NODE_ENV=development
PORT=3000

# ============================================
# 视频生成 Provider
# 可选: mock | runway | pika | seedance | minimax | wan
# ============================================
VIDEO_PROVIDER=mock

# Runway API (https://runwayml.com/)
RUNWAY_API_KEY=
# RUNWAY_MODEL=gen3a_turbo

# Pika API (https://pika.art/)
PIKA_API_KEY=
# PIKA_MODEL=pika-1.0

# Seedance / 字节跳动方舟 (https://www.volcengine.com/docs/82379)
SEEDANCE_API_KEY=
# SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDANCE_MODEL=seedance-2.5

# Minimax / 海螺 AI (https://platform.minimaxi.com/)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=video-01

# Wan / 通义万相 (https://help.aliyun.com/zh/dashscope/)
WAN_API_KEY=
# WAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# WAN_MODEL=wanx2.1-t2v-plus

# 视频生成并发数
VIDEO_MAX_CONCURRENT=3

# ============================================
# LLM Provider (剧本助手 / AI 影评)
# 可选: mock | openai
# 支持任何 OpenAI 兼容 API（vLLM、Ollama、Azure 等）
# ============================================
LLM_PROVIDER=mock
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# 自定义 API 端点（用于兼容其他 OpenAI 兼容服务）
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# TTS Provider (配音字幕)
# 可选: mock | elevenlabs
# ============================================
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4Tlv
# ELEVENLABS_MODEL=eleven_monolingual_v1

# ============================================
# Image Provider (R32 图片生成)
# 可选: mock | openai
# openai 兼容任何 OpenAI Images API 服务，可用 OPENAI_IMAGE_BASE_URL 指向自建网关
# ============================================
IMAGE_PROVIDER=mock
OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-1

# ============================================
# 角色一致性
# ============================================
CHARACTER_CONSISTENCY_THRESHOLD=0.65

# ============================================
# 存储
# ============================================
STORAGE_PATH=./storage

# ============================================
# 认证
# ============================================
JWT_SECRET=dreamreel-dev-secret-change-in-production
# JWT_EXPIRES_IN=7d

# ============================================
# 支付（Stripe，可选）
# ============================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
