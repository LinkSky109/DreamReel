{
  "name": "dreamreel",
  "version": "0.1.0",
  "description": "DreamReel / 梦卷 — AI短片创作平台：从一句话想法到成片输出",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:backend": "node --watch src/server.js",
    "dev:frontend": "node scripts/frontend-server.js",
    "dev:all": "node scripts/frontend-server.js & node --watch src/server.js",
    "test": "node scripts/run-tests.js",
    "lint": "eslint src/ tests/ public/js/",
    "seed:audio": "node scripts/seed_audio_pack.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "ai-video",
    "video-generation",
    "scriptwriting",
    "dubbing",
    "subtitles"
  ],
  "author": "DreamReel Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
