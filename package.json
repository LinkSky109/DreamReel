{
  "name": "dreamreel",
  "version": "0.1.0",
  "description": "DreamReel / 梦卷 — AI短片创作平台：从一句话想法到成片输出",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:backend": "node --watch src/server.js",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:all": "vite --config web/vite.config.ts & node --watch src/server.js",
    "dev:frontend": "node scripts/frontend-server.js",
    "build": "vite build --config web/vite.config.ts",
    "build:web": "WEB_OUT_DIR=dist vite build --config web/vite.config.ts && node scripts/copy-web-assets.js",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test": "node scripts/run-tests.js",
    "test:web": "vitest run --config web/vite.config.ts",
    "check": "npm run lint && npm run typecheck && npm run check:docs && npm test && npm run test:web",
    "lint": "eslint src/ tests/ public/js/",
    "seed:audio": "node scripts/seed_audio_pack.js",
    "seed:community": "node scripts/seed-community.js",
    "novel": "node scripts/novel.js",
    "llm:serve": "node scripts/llm-serve.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"web/src/**/*.{ts,tsx,css}\"",
    "prebuild": "node scripts/clean-web-build.js",
    "build:web:embed": "vite build --config web/vite.config.ts",
    "start:api": "node src/server.js",
    "inventory": "node scripts/inventory.js",
    "check:docs": "node scripts/check-docs-endpoints.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:status": "node scripts/db-migrate.js --status",
    "db:migrate:novels": "node scripts/migrate-novels-to-pg.js",
    "db:verify:novels": "node scripts/migrate-novels-to-pg.js --verify",
    "db:migrate:novel-children": "node scripts/migrate-novel-children-to-pg.js",
    "db:verify:novel-children": "node scripts/migrate-novel-children-to-pg.js --verify",
    "outbox:stats": "node scripts/outbox.js --stats",
    "outbox:run": "node scripts/outbox.js --run-once",
    "outbox:retry-dead": "node scripts/outbox.js --retry-dead",
    "audit:verify": "node scripts/audit.js --verify"
  },
  "keywords": [
    "ai-video",
    "video-generation",
    "scriptwriting",
    "dubbing",
    "subtitles"
  ],
  "author": "DreamReel Team",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "ai": "^7.0.137",
    "ai-sdk-provider-opencode-sdk": "^5.0.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "kysely": "^0.29.7",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "uuid": "^10.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.10.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.3.3",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
