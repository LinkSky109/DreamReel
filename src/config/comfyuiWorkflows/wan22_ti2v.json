{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "Wan2.2-TI2V-5B-Q4_K_M.gguf" },
    "_meta": { "title": "Load Wan2.2 TI2V-5B (GGUF)" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan" },
    "_meta": { "title": "Load Wan text encoder" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan2.2_vae.safetensors" },
    "_meta": { "title": "Load Wan VAE" }
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["1", 0], "shift": 8.0 },
    "_meta": { "title": "ModelSamplingSD3" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "cinematic shot, natural camera motion, high detail", "clip": ["2", 0] },
    "_meta": { "title": "Positive" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "blurry, static, distorted, low quality", "clip": ["2", 0] },
    "_meta": { "title": "Negative" }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": { "image": "sample_scene.png" },
    "_meta": { "title": "Start image (i2v)" }
  },
  "8": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": ["3", 0],
      "width": 832,
      "height": 480,
      "length": 49,
      "batch_size": 1,
      "start_image": ["7", 0]
    },
    "_meta": { "title": "Wan22 I2V latent" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["8", 0],
      "denoise": 1.0
    },
    "_meta": { "title": "KSampler" }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["3", 0] },
    "_meta": { "title": "VAEDecode" }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["10", 0], "fps": 16 },
    "_meta": { "title": "Images → Video" }
  },
  "11": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "dreamreel",
      "format": "mp4",
      "codec": "h264"
    },
    "_meta": { "title": "Save MP4 (H.264)" }
  }
}
